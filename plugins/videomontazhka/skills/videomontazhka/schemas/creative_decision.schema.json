{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sprut:creative-router:decision:v1",
  "title": "SPRUT creative tool decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "router_version",
    "map_id",
    "decision",
    "none_reason",
    "primary_effect",
    "supporting_effects",
    "density",
    "rejected_candidates",
    "required_qa",
    "guardrails",
    "provenance"
  ],
  "properties": {
    "version": {"const": 1},
    "router_version": {"const": "sprut-creative-router-1"},
    "map_id": {"const": "sprut-creative-tool-map-v1"},
    "decision": {"enum": ["effect", "none"]},
    "none_reason": {"type": ["string", "null"], "maxLength": 500},
    "primary_effect": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/selectedEffect"}
      ]
    },
    "supporting_effects": {
      "type": "array",
      "maxItems": 1,
      "items": {"$ref": "#/$defs/selectedEffect"}
    },
    "density": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_start_s",
        "window_end_s",
        "primary_events_before",
        "hero_events_before",
        "audio_support_events_before",
        "visual_coverage_ratio_before",
        "active_visual_layers_before",
        "limits",
        "blocks"
      ],
      "properties": {
        "window_start_s": {"type": "number", "minimum": 0},
        "window_end_s": {"type": "number", "minimum": 0},
        "primary_events_before": {"type": "integer", "minimum": 0},
        "hero_events_before": {"type": "integer", "minimum": 0},
        "audio_support_events_before": {"type": "integer", "minimum": 0},
        "visual_coverage_ratio_before": {"type": "number", "minimum": 0, "maximum": 1},
        "active_visual_layers_before": {"type": "integer", "minimum": 0},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window_s",
            "max_primary_events",
            "max_hero_events",
            "max_audio_support_events",
            "max_visual_coverage_ratio",
            "max_active_visual_layers",
            "max_supporting_effects"
          ],
          "properties": {
            "window_s": {"type": "number", "exclusiveMinimum": 0},
            "max_primary_events": {"type": "integer", "minimum": 0},
            "max_hero_events": {"type": "integer", "minimum": 0},
            "max_audio_support_events": {"type": "integer", "minimum": 0},
            "max_visual_coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "max_active_visual_layers": {"type": "integer", "minimum": 0},
            "max_supporting_effects": {"type": "integer", "minimum": 0, "maximum": 1}
          }
        },
        "blocks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "rejected_candidates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "effect_id", "code", "reason"],
        "properties": {
          "tool_id": {"$ref": "#/$defs/toolId"},
          "effect_id": {"$ref": "#/$defs/toolId"},
          "code": {"$ref": "#/$defs/toolId"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "required_qa": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "asset_provenance",
          "audio_mix_review",
          "boundary_frame_review",
          "caption_collision_review",
          "diagram_legibility_review",
          "full_preview_user_approval",
          "matte_edge_review",
          "motion_stability_review",
          "transition_asset_qa",
          "visual_preview_sheet"
        ]
      }
    },
    "guardrails": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_id",
        "section_id",
        "meaning_ids",
        "semantic_plan_sha256",
        "approval_sha256",
        "feature_input_sha256",
        "tool_map_sha256",
        "input_schema_sha256",
        "output_schema_sha256",
        "router_sha256"
      ],
      "properties": {
        "visual_id": {"$ref": "#/$defs/id"},
        "section_id": {"$ref": "#/$defs/id"},
        "meaning_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "semantic_plan_sha256": {"$ref": "#/$defs/sha256"},
        "approval_sha256": {"$ref": "#/$defs/sha256"},
        "feature_input_sha256": {"$ref": "#/$defs/sha256"},
        "tool_map_sha256": {"$ref": "#/$defs/sha256"},
        "input_schema_sha256": {"$ref": "#/$defs/sha256"},
        "output_schema_sha256": {"$ref": "#/$defs/sha256"},
        "router_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"const": "effect"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "none_reason": {"type": "null"},
          "primary_effect": {"$ref": "#/$defs/selectedEffect"}
        }
      }
    },
    {
      "if": {
        "properties": {"decision": {"const": "none"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "none_reason": {"type": "string", "minLength": 1},
          "primary_effect": {"type": "null"},
          "supporting_effects": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "toolId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]{0,79}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selectedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "effect_id",
        "label",
        "kind",
        "family",
        "intensity",
        "duration_s",
        "full_frame",
        "matched_signals",
        "recipe",
        "rationale"
      ],
      "properties": {
        "tool_id": {"$ref": "#/$defs/toolId"},
        "effect_id": {"$ref": "#/$defs/toolId"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "kind": {"enum": ["primary_visual", "support_audio"]},
        "family": {"$ref": "#/$defs/toolId"},
        "intensity": {"enum": ["restrained", "medium", "hero"]},
        "duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "full_frame": {"type": "boolean"},
        "matched_signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "recipe": {"type": "string", "minLength": 1, "maxLength": 1000},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
