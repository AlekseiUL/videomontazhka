# Copy outside the repository to the product settings path shown in docs/INSTALL.md.
# Never place a populated .env in this checkout or in a video project.

# Optional paid transcription. Leave empty to keep cloud transcription disabled.
ELEVENLABS_API_KEY=

# Optional explicit runtime overrides. Defaults are selected by doctor/installers.
VIDEOMONTAZHKA_HOME=
VIDEOMONTAZHKA_RUNTIME_DIR=
VIDEOMONTAZHKA_CACHE_HOME=
VIDEOMONTAZHKA_PYTHON=
VIDEOMONTAZHKA_ENV_FILE=
SPRUT_HYPERFRAMES_BIN=
SPRUT_GSAP_PACKAGE_ROOT=
SPRUT_QA_PYTHON=
